        this.userAnswers = [];
        this.timer = null;
        this.timeLeft = 30;
        this.timerEnabled = true;
        this.isAnswered = false;

        // Flashcard State
        this.fcIndex = 0;
        this.fcFlipped = false;

        // Bookmarks
        this.bookmarks = JSON.parse(localStorage.getItem('ai_quiz_bookmarks') || '[]');
        this.topScore = parseInt(localStorage.getItem('ai_quiz_topscore') || '0');

        this.initUI();
      }

      initUI() {
        document.getElementById('top-score-display').textContent = this.topScore;
        this.renderBankList(QUIZ_DATA);
        this.updateFlashcard();
      }

      navTo(viewName) {
        this.sound.play('click');
        this.activeView = viewName;

        // Hide all views
        ['home', 'quiz', 'result', 'flashcard', 'bank'].forEach(v => {
          const el = document.getElementById(`view-${v}`);
          if (el) el.classList.add('hidden');
        });

        // Show active view
        const targetView = document.getElementById(`view-${viewName}`);
        if (targetView) targetView.classList.remove('hidden');

        // Update nav button highlights
        ['home', 'flashcard', 'bank'].forEach(v => {
          const btn = document.getElementById(`nav-${v}`);
          if (btn) {
            if (v === viewName) {
              btn.className = "px-4 py-1.5 rounded-lg text-sm font-medium transition text-brand-500 bg-slate-800";
            } else {
              btn.className = "px-4 py-1.5 rounded-lg text-sm font-medium transition text-slate-400 hover:text-white";
            }
          }
        });

        // Stop timer if leaving quiz
        if (viewName !== 'quiz') {
          this.stopTimer();
        }
      }

      toggleSound() {
        this.sound.enabled = !this.sound.enabled;
        const btn = document.getElementById('sound-btn');
        if (this.sound.enabled) {
          btn.innerHTML = '<i class="fa-solid fa-volume-high text-sm"></i>';
          this.showToast('Suara Diaktifkan');
          this.sound.play('click');
        } else {
          btn.innerHTML = '<i class="fa-solid fa-volume-xmark text-sm"></i>';
          this.showToast('Suara Dimatikan');
        }
      }

      showToast(message) {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        toast.className = "bg-slate-800 text-white border border-slate-700 px-4 py-2 rounded-xl text-xs font-semibold shadow-2xl animate-bounce";
        toast.textContent = message;
        container.appendChild(toast);
        setTimeout(() => toast.remove(), 2500);
      }

      /* ==========================================================================
         QUIZ GAMEPLAY LOGIC
         ========================================================================== */
      startQuiz(questionCount) {
        this.sound.play('click');
        this.timerEnabled = document.getElementById('timer-toggle').checked;
        
        // Shuffle & slice questions
        const shuffled = [...QUIZ_DATA].sort(() => 0.5 - Math.random());
        this.activeQuestions = shuffled.slice(0, questionCount);
        
        this.currentIndex = 0;
        this.score = 0;
        this.streak = 0;
        this.userAnswers = [];
        
        this.navTo('quiz');
        this.renderQuestion();
      }

      renderQuestion() {
        this.isAnswered = false;
        const q = this.activeQuestions[this.currentIndex];

        // UI Updates
        document.getElementById('quiz-progress-text').textContent = `${this.currentIndex + 1} / ${this.activeQuestions.length}`;
        document.getElementById('quiz-progress-bar').style.width = `${((this.currentIndex + 1) / this.activeQuestions.length) * 100}%`;
        document.getElementById('quiz-streak-count').textContent = this.streak;
        
        document.getElementById('question-category').textContent = q.category;
        document.getElementById('question-text').textContent = q.question;

        // Hide explanation & disable next button
        const expBox = document.getElementById('explanation-box');
        expBox.classList.add('hidden');
        
        const nextBtn = document.getElementById('next-btn');
        nextBtn.disabled = true;
        nextBtn.className = "px-6 py-2.5 rounded-xl bg-slate-800 text-slate-500 font-semibold text-sm transition flex items-center gap-2 cursor-not-allowed";

        // Update bookmark icon state
        this.updateBookmarkButton();

        // Render Options
        const optionsContainer = document.getElementById('options-container');
        optionsContainer.innerHTML = '';

        const optionPrefixes = ['A', 'B', 'C', 'D'];
        q.options.forEach((optText, idx) => {
          const optBtn = document.createElement('button');
          optBtn.className = "w-full text-left p-4 rounded-2xl bg-slate-900/80 border border-slate-800 hover:border-brand-500/50 hover:bg-slate-800/80 text-slate-200 transition-all flex items-center gap-3 text-sm font-medium group cursor-pointer";
          optBtn.onclick = () => this.selectOption(idx);
          optBtn.id = `option-btn-${idx}`;

          optBtn.innerHTML = `
            <span class="w-8 h-8 rounded-xl bg-slate-800 border border-slate-700 flex items-center justify-center text-xs font-bold text-slate-400 group-hover:text-brand-400 group-hover:border-brand-500/50 transition">
              ${optionPrefixes[idx]}
            </span>
            <span class="flex-grow">${optText}</span>
          `;
          optionsContainer.appendChild(optBtn);
        });

        // Start Timer
        this.startTimer();
      }

      startTimer() {
        this.stopTimer();
        const timerContainer = document.getElementById('timer-container');
        if (!this.timerEnabled) {
          timerContainer.classList.add('hidden');
          return;
        }
        timerContainer.classList.remove('hidden');
        this.timeLeft = 30;
        document.getElementById('quiz-timer').textContent = `${this.timeLeft}s`;

        this.timer = setInterval(() => {
          this.timeLeft--;
          document.getElementById('quiz-timer').textContent = `${this.timeLeft}s`;

          if (this.timeLeft <= 5 && this.timeLeft > 0) {
            this.sound.play('tick');
          }

          if (this.timeLeft <= 0) {
            this.stopTimer();
            this.timeOutAnswer();
          }
        }, 1000);
      }

      stopTimer() {
        if (this.timer) {
          clearInterval(this.timer);
          this.timer = null;
        }
      }

      timeOutAnswer() {
        if (this.isAnswered) return;
        this.selectOption(-1); // -1 signifies timeout
      }

      selectOption(selectedIdx) {
        if (this.isAnswered) return;
        this.isAnswered = true;
        this.stopTimer();

        const q = this.activeQuestions[this.currentIndex];
        const isCorrect = selectedIdx === q.answer;

        // Save answer record
        this.userAnswers.push({
          question: q,
          selected: selectedIdx,
          correct: isCorrect
        });

        // Option styles highlight
        q.options.forEach((_, idx) => {
          const btn = document.getElementById(`option-btn-${idx}`);
          btn.disabled = true;
          btn.classList.remove('hover:border-brand-500/50', 'hover:bg-slate-800/80');

          if (idx === q.answer) {
            // Correct answer styling
            btn.className = "w-full text-left p-4 rounded-2xl bg-emerald-950/60 border-2 border-emerald-500 text-emerald-200 transition-all flex items-center gap-3 text-sm font-semibold glow-success";
          } else if (idx === selectedIdx) {
            // Wrong selected answer styling
            btn.className = "w-full text-left p-4 rounded-2xl bg-rose-950/60 border-2 border-rose-500 text-rose-200 transition-all flex items-center gap-3 text-sm font-semibold glow-danger";
          } else {
            btn.classList.add('opacity-40');
          }
        });

        // Score & streak calculation
        if (isCorrect) {
          this.score += 10 + (this.streak * 2);
          this.streak++;
          this.sound.play('correct');
        } else {
          this.streak = 0;
          this.sound.play('wrong');
        }

        // Show Explanation
        const expBox = document.getElementById('explanation-box');
        const expTitle = document.getElementById('explanation-title');
        const expText = document.getElementById('explanation-text');

        expBox.classList.remove('hidden');
        if (isCorrect) {
          expBox.className = "rounded-2xl p-5 border text-sm space-y-2 bg-emerald-950/40 border-emerald-500/40";
          expTitle.className = "flex items-center gap-2 font-bold text-emerald-400";
          expTitle.innerHTML = '<i class="fa-solid fa-circle-check"></i> Jawaban Benar!';
        } else {
          expBox.className = "rounded-2xl p-5 border text-sm space-y-2 bg-rose-950/40 border-rose-500/40";
          expTitle.className = "flex items-center gap-2 font-bold text-rose-400";
          expTitle.innerHTML = selectedIdx === -1 ? '<i class="fa-solid fa-hourglass-end"></i> Waktu Habis!' : '<i class="fa-solid fa-circle-xmark"></i> Jawaban Kurang Tepat';
        }
        expText.textContent = q.explanation;

        // Enable Next Button
        const nextBtn = document.getElementById('next-btn');
        nextBtn.disabled = false;
        nextBtn.className = "px-6 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm transition flex items-center gap-2 shadow-lg hover:shadow-brand-500/20 cursor-pointer";
      }

      nextQuestion() {
        this.sound.play('click');
        this.currentIndex++;
        if (this.currentIndex < this.activeQuestions.length) {
          this.renderQuestion();
        } else {
          this.finishQuiz();
        }
      }

      finishQuiz() {
        this.stopTimer();
        this.sound.play('win');

        // Confetti burst
        try {
          confetti({
            particleCount: 100,
            spread: 70,
            origin: { y: 0.6 }
          });
        } catch (e) {}

        const total = this.activeQuestions.length;
        const correctCount = this.userAnswers.filter(a => a.correct).length;
        const wrongCount = total - correctCount;
        const accuracy = Math.round((correctCount / total) * 100);

        // Update High score
        if (this.score > this.topScore) {
          this.topScore = this.score;
          localStorage.setItem('ai_quiz_topscore', this.topScore);
          document.getElementById('top-score-display').textContent = this.topScore;
        }

        // Rank Badge Calculation
        let rankTitle = "AI Apprentice";
        let rankIcon = "fa-brain";
        if (accuracy >= 90) {
          rankTitle = "AI Grandmaster 🏆";
          rankIcon = "fa-crown";
        } else if (accuracy >= 75) {
          rankTitle = "Neural Engineer ⚡";
          rankIcon = "fa-microchip";
        } else if (accuracy >= 50) {
          rankTitle = "Data Explorer 🔍";
          rankIcon = "fa-compass";
        }

        document.getElementById('result-rank-title').textContent = rankTitle;
        document.getElementById('result-badge-icon').className = `fa-solid ${rankIcon}`;
        document.getElementById('res-score').textContent = this.score;
        document.getElementById('res-accuracy').textContent = `${accuracy}%`;
        document.getElementById('res-correct').textContent = correctCount;
        document.getElementById('res-wrong').textContent = wrongCount;

        this.navTo('result');
      }

      reviewAnswers() {
        const reviewSection = document.getElementById('review-section');
        reviewSection.classList.toggle('hidden');
        
        const list = document.getElementById('review-list');
        list.innerHTML = '';

        this.userAnswers.forEach((ans, idx) => {
          const item = document.createElement('div');
          item.className = `p-4 rounded-2xl border text-sm space-y-2 ${ans.correct ? 'bg-emerald-950/20 border-emerald-500/30' : 'bg-rose-950/20 border-rose-500/30'}`;
          
          const prefix = ['A', 'B', 'C', 'D'];
          const userAnsText = ans.selected >= 0 ? `${prefix[ans.selected]}. ${ans.question.options[ans.selected]}` : 'Tidak dijawab (Timeout)';
          const correctAnsText = `${prefix[ans.question.answer]}. ${ans.question.options[ans.question.answer]}`;

          item.innerHTML = `
            <div class="flex items-center justify-between font-bold">
              <span class="text-white">${idx + 1}. ${ans.question.question}</span>
              <span class="${ans.correct ? 'text-emerald-400' : 'text-rose-400'}">
                ${ans.correct ? '<i class="fa-solid fa-check"></i> Benar' : '<i class="fa-solid fa-xmark"></i> Salah'}
              </span>
            </div>
            <p class="text-xs text-slate-400">Jawaban Kamu: <span class="${ans.correct ? 'text-emerald-300' : 'text-rose-300'} font-semibold">${userAnsText}</span></p>
            ${!ans.correct ? `<p class="text-xs text-emerald-400">Kunci Jawaban: <span class="font-semibold">${correctAnsText}</span></p>` : ''}
            <div class="pt-2 border-t border-slate-800 text-xs text-slate-300">
              💡 <span class="font-semibold text-slate-200">Pembahasan:</span> ${ans.question.explanation}
            </div>
          `;
          list.appendChild(item);
        });
      }

      /* ==========================================================================
         BOOKMARKS & FLASHCARD LOGIC
         ========================================================================== */
      bookmarkCurrentQuestion() {
        const q = this.activeQuestions[this.currentIndex];
        const existsIdx = this.bookmarks.findIndex(b => b.id === q.id);

        if (existsIdx > -1) {
          this.bookmarks.splice(existsIdx, 1);
          this.showToast('Soal dihapus dari simpanan');
        } else {
          this.bookmarks.push(q);
          this.showToast('Soal tersimpan ke Bank Soal!');
        }

        localStorage.setItem('ai_quiz_bookmarks', JSON.stringify(this.bookmarks));
        this.updateBookmarkButton();
      }

      updateBookmarkButton() {
        const q = this.activeQuestions[this.currentIndex];
        const exists = this.bookmarks.some(b => b.id === q.id);
        const btn = document.getElementById('bookmark-btn');
        if (exists) {
          btn.innerHTML = '<i class="fa-solid fa-bookmark text-amber-400"></i> Tersimpan';
          btn.className = "text-xs sm:text-sm text-amber-400 font-semibold transition flex items-center gap-2";
        } else {
          btn.innerHTML = '<i class="fa-regular fa-bookmark"></i> Simpan Soal Ini';
          btn.className = "text-xs sm:text-sm text-slate-400 hover:text-amber-400 transition flex items-center gap-2";
        }
      }

      // Flashcard Functions
      flipFlashcard() {
        this.sound.play('click');
        this.fcFlipped = !this.fcFlipped;
        const inner = document.getElementById('flashcard-inner');
        if (this.fcFlipped) {
          inner.classList.add('rotate-y-180');
        } else {
          inner.classList.remove('rotate-y-180');
        }
      }

      updateFlashcard() {
        this.fcFlipped = false;
        document.getElementById('flashcard-inner').classList.remove('rotate-y-180');

        const q = QUIZ_DATA[this.fcIndex];
        const prefix = ['A', 'B', 'C', 'D'];

        document.getElementById('fc-current').textContent = this.fcIndex + 1;
        document.getElementById('fc-total').textContent = QUIZ_DATA.length;
        document.getElementById('fc-question-text').textContent = q.question;
        document.getElementById('fc-answer-text').textContent = `Jawaban: ${prefix[q.answer]}. ${q.options[q.answer]}`;
        document.getElementById('fc-explanation-text').textContent = q.explanation;
      }

      nextFlashcard() {
        this.sound.play('click');
        this.fcIndex = (this.fcIndex + 1) % QUIZ_DATA.length;
        this.updateFlashcard();
      }

      prevFlashcard() {
        this.sound.play('click');
        this.fcIndex = (this.fcIndex - 1 + QUIZ_DATA.length) % QUIZ_DATA.length;
        this.updateFlashcard();
      }

      /* ==========================================================================
         STUDY BANK CATALOG LOGIC
         ========================================================================== */
      renderBankList(items) {
        const container = document.getElementById('bank-list-container');
        container.innerHTML = '';

        const prefix = ['A', 'B', 'C', 'D'];

        items.forEach(q => {
          const card = document.createElement('div');
          card.className = "glass-card rounded-2xl p-6 border border-slate-800 space-y-4 hover:border-slate-700 transition";
          
          card.innerHTML = `
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono px-3 py-1 rounded-full bg-slate-800 text-brand-400 border border-slate-700">
                #${q.id} • ${q.category}
              </span>
            </div>
            <h4 class="text-lg font-bold text-white">${q.question}</h4>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              ${q.options.map((opt, i) => `
                <div class="p-2.5 rounded-xl ${i === q.answer ? 'bg-emerald-950/60 border border-emerald-500/50 text-emerald-300 font-semibold' : 'bg-slate-900/60 border border-slate-800 text-slate-400'}">
                  ${prefix[i]}. ${opt} ${i === q.answer ? '✓' : ''}
                </div>
              `).join('')}
            </div>
            <div class="p-4 rounded-xl bg-slate-900/90 border border-slate-800 text-xs text-slate-300 space-y-1">
              <span class="font-bold text-brand-400"><i class="fa-solid fa-lightbulb"></i> Pembahasan:</span>
              <p>${q.explanation}</p>
            </div>
          `;
          container.appendChild(card);
        });
      }

      filterBank() {
        const query = document.getElementById('search-bank').value.toLowerCase();
        const filtered = QUIZ_DATA.filter(q => 
          q.question.toLowerCase().includes(query) ||
          q.category.toLowerCase().includes(query) ||
          q.options.some(o => o.toLowerCase().includes(query))
        );
        this.renderBankList(filtered);
      }
    }

    /* Initialize App on DOM Load */
    let app = null;
    window.addEventListener('DOMContentLoaded', () => {
      app = new QuizApp();
    });
  </script>
</body>
</html>
