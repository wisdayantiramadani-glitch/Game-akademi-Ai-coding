    /* ==========================================================================
       AUDIO SYNTHESIZER (TONE.JS) & APPLICATION STATE MANAGER
       ========================================================================== */
    class SoundEngine {
      constructor() {
        this.enabled = true;
        this.synth = null;
        this.polySynth = null;
        this.init();
      }

      init() {
        try {
          this.synth = new Tone.Synth().toDestination();
          this.polySynth = new Tone.PolySynth().toDestination();
          this.synth.volume.value = -12;
          this.polySynth.volume.value = -10;
        } catch (e) {
          console.warn("Audio Context init fallback:", e);
        }
      }

      play(type) {
        if (!this.enabled) return;
        try {
          if (Tone.context.state !== 'running') {
            Tone.start();
          }
          const now = Tone.now();
          if (type === 'correct') {
            this.polySynth.triggerAttackRelease(["C5", "E5", "G5"], "16n", now);
          } else if (type === 'wrong') {
            this.synth.triggerAttackRelease("C3", "8n", now);
          } else if (type === 'click') {
            this.synth.triggerAttackRelease("G4", "32n", now);
          } else if (type === 'win') {
            this.polySynth.triggerAttackRelease(["C4", "E4", "G4", "C5"], "8n", now);
          } else if (type === 'tick') {
            this.synth.triggerAttackRelease("C6", "64n", now);
          }
        } catch (e) {
          // Ignore audio play errors
        }
      }
    }

    class QuizApp {
      constructor() {
        this.sound = new SoundEngine();
        this.activeView = 'home';
        
        // Quiz State
        this.activeQuestions = [];
